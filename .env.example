# Run: uv run python scripts/init_env.py (generates separate random local secrets).
API_TOKEN=replace-with-at-least-24-random-characters
INGEST_TOKEN=replace-with-a-different-random-secret
LAB_TOKEN=replace-with-another-different-random-secret
CONTROL_DB_PASSWORD=replace-control-db-password
LAB_DB_PASSWORD=replace-lab-db-password
DATABASE_URL=sqlite:///./aiops.db
LAB_URL=http://127.0.0.1:8100
MONITOR_ENABLED=true
MONITOR_INTERVAL=5
FAILURE_THRESHOLD=2
DIAGNOSIS_PROVIDER=rules
OPENAI_API_KEY=
OPENAI_MODEL=
QDRANT_URL=
ENABLE_LAB_EXECUTION=false
APPROVAL_TTL_SECONDS=300
# Set true only when the application is served over HTTPS.
COOKIE_SECURE=false
